<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ============================================================
         VEHICLE TYPES — Modeling driver heterogeneity
         
         Theory: Real traffic is not homogeneous. Drivers have 
         different reaction times (tau), aggressiveness (sigma),
         and speed preferences (speedFactor).
         
         - tau = desired time headway [s] (lower = more aggressive)
         - sigma = driver imperfection (0=perfect, 1=very random)
         - speedFactor = distribution of desired speed relative to limit
         - lcSpeedGain = willingness to change lane for speed gain
         ============================================================ -->

    <vType id="human_aggressive"
           accel="2.5" decel="6" emergencyDecel="7.0"
           length="5" minGap="1" maxSpeed="40"
           speedFactor="normc(1.1,0.1,0.7,2)"
           tau="1.2" sigma="0.5"
           lcSpeedGain="10" lcStrategic="1" lcKeepRight="1"
           lcSpeedGainLookahead="1.0"
           probability="0.30" color="1,0,0"/>

    <vType id="human_normal"
           accel="2" decel="5" emergencyDecel="7.0"
           length="5" minGap="1.5" maxSpeed="40"
           speedFactor="normc(1,0.15,0.5,1.5)"
           tau="1.5" sigma="0.5"
           lcSpeedGain="5" lcStrategic="3" lcKeepRight="3"
           lcSpeedGainLookahead="2"
           probability="0.50" color="0,1,0"/>

    <vType id="human_slow"
           accel="2" decel="4.5" emergencyDecel="6.0"
           length="5" minGap="2" maxSpeed="40"
           speedFactor="normc(0.9,0.1,0.2,1.2)"
           tau="1.8" sigma="0.2"
           lcSpeedGain="1" lcStrategic="6" lcKeepRight="6"
           lcSpeedGainLookahead="4"
           probability="0.20" color="0,0,1"/>

       <!-- A special vehicle for incident scenarios -->
       <vType id="incident_vehicle"
           accel="1.0" decel="4.5" emergencyDecel="6.0"
           length="5" minGap="1" maxSpeed="10"
           color="1,1,0"/>

    <!-- Distribution: 30% aggressive + 50% normal + 20% slow -->
    <vTypeDistribution id="humanDist"
                       vTypes="human_aggressive human_normal human_slow"/>


    <!-- ============================================================
         ROUTE — The path vehicles follow on the Tangenziale di Napoli
         
         Theory: In S0 (no-ITS), vehicles follow a FIXED explicit 
         route. They cannot reroute because there is no information
         system telling them about the accident. This is the key 
         difference from S1/S2 where from/to routing is used instead.
         
         The route passes through:
         Entry → Diversion edge → Reference edge → Accident edge → Exit
         ============================================================ -->

    <route id="main_route" edges="983584629 230252807-AddedOnRampEdge 230252807 230252807-AddedOffRampEdge 29427484#1 106788494#1-AddedOnRampEdge 106788494#1 106788494#1-AddedOffRampEdge 416695566 508357075 508357075-AddedOffRampEdge 414445835 426900863#1-AddedOnRampEdge 426900863#1 426900863#1-AddedOffRampEdge 503984440 188862970#1-AddedOnRampEdge 188862970#1 188862970#1-AddedOffRampEdge 106874397#0"/>
    
    <!-- ============================================================
         TRAFFIC FLOWS — 2000 veh/hr total (≈667 per lane)
         
         Theory: The demand q = 2000 veh/hr is below the road's 
         capacity (Cap). Under normal conditions, traffic flows freely.
         When the accident occurs, the local capacity drops to 0 
         (all lanes blocked), creating a bottleneck. The incoming 
         flow q > 0 = bottleneck capacity, so a queue forms and 
         a shockwave propagates upstream.
         ============================================================ -->

    <flow id="main_lane0" begin="0" end="3600" vehsPerHour="666.67"
          type="humanDist" route="main_route"
          departLane="0" departPos="0" departSpeed="avg"/>

    <flow id="main_lane1" begin="0" end="3600" vehsPerHour="666.67"
          type="humanDist" route="main_route"
          departLane="1" departPos="0" departSpeed="avg"/>

    <flow id="main_lane2" begin="0" end="3600" vehsPerHour="666.67"
          type="humanDist" route="main_route"
          departLane="2" departPos="0" departSpeed="avg"/>



       <!-- ============================================================
         ACCIDENT — Two-lane closure at t=600s on edge 426900863#1
         
         Theory: The accident is modeled as stopped vehicles blocking 
         lanes. At t=600s, 3 incident vehicles appear at position 295 
         on edge 426900863#1 with speed=0 and stop for 900 seconds 
         (until t=1500s).
         
         This creates a bottleneck with capacity = 0. According to 
         the shockwave equation u = (q1-q2)/(k1-k2), with q2=0 
         (no flow downstream of accident) and q1=2000 veh/hr 
         (incoming flow), the shockwave propagates backward.
         ============================================================ -->

    <!-- Accident blockage routes: one stopped incident vehicle per lane -->
    <route id="accident_route_0"
           edges="426900863#1 426900863#1-AddedOffRampEdge 163006129">
        <stop lane="426900863#1_0" endPos="300" duration="900"/>
    </route>

    <route id="accident_route_1"
           edges="426900863#1 426900863#1-AddedOffRampEdge 163006129">
        <stop lane="426900863#1_1" endPos="300" duration="900"/>
    </route>

    <route id="accident_route_2"
           edges="426900863#1 426900863#1-AddedOffRampEdge 163006129">
        <stop lane="426900863#1_2" endPos="300" duration="900"/>
    </route>

    <vehicle id="accident_block_lane0"
             type="incident_vehicle"
             route="accident_route_0"
             depart="600"
             departLane="0"
             departPos="295"
             departSpeed="0"/>

    <vehicle id="accident_block_lane1"
             type="incident_vehicle"
             route="accident_route_1"
             depart="600"
             departLane="1"
             departPos="295"
             departSpeed="0"/>

    <vehicle id="accident_block_lane2"
             type="incident_vehicle"
             route="accident_route_2"
             depart="600"
             departLane="2"
             departPos="295"
             departSpeed="0"/>


</routes>
